# Supabase project URL and publishable (anon) key — safe to expose in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional Google Maps Embed URL for Contact Us page (also configurable in Admin Settings)
VITE_MAP_EMBED_URL=

# Server-side only (never prefix with VITE_). Used by supabase/seed.mjs.
# DATABASE_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres

# Resend — loaded into Supabase Vault by supabase/apply.mjs and read by the
# notify_enquiry trigger. Never prefix these with VITE_.
# RESEND_API_KEY=re_...
# RESEND_FROM=Modu Pro <onboarding@resend.dev>
